# BathCraft — environment template. Placeholders only; never commit real values.
# Copy to `.env.local` (git-ignored) and fill in.

# ─── Auth.js session encryption ──────────────────────────────────────────────
# Signs and encrypts the session cookie. Generate with:  npx auth secret
# Rotating this signs everyone out. It must differ between dev and production.
AUTH_SECRET=your_auth_secret

# ─── Google OAuth 2.0 / OpenID Connect ───────────────────────────────────────
# From Google Cloud Console → Google Auth Platform → Clients → Web application.
# These exact names are what Auth.js v5 auto-detects for the Google provider.
# AUTH_GOOGLE_SECRET is server-only — it must never be prefixed NEXT_PUBLIC_.
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# ─── Deployment URL ──────────────────────────────────────────────────────────
# Only needed where Auth.js cannot infer the origin. Vercel sets this itself;
# leave it unset locally (http://localhost:3000 is the default).
# AUTH_URL=https://your-production-domain.example/api/auth

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Supabase Dashboard → Project Settings → Data API  (URL)
#                    → Project Settings → API Keys  (service_role key)
#
# SERVICE ROLE bypasses Row Level Security and is a full-access credential.
# Server-only: never prefix it NEXT_PUBLIC_, never import it in a component.
# Without both of these the app falls back to a JSON file store, which is
# development only and does NOT work on Vercel.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Local file store (development fallback only) ────────────────────────────
# Used only when the Supabase vars above are unset. See lib/db/store.ts.
# BATHCRAFT_DATA_FILE=./.data/bathcraft.json

# ─── Email (SMTP) — password reset links ─────────────────────────────────────
# Sends the "forgot password" email. Without SMTP_HOST no mail is sent: in
# development the message (with the reset link) is logged to the server console
# instead; in production the reset flow silently sends nothing, so set these.
#
# GMAIL: use an App Password, NOT your normal password. Turn on 2-Step
# Verification, then create one at https://myaccount.google.com/apppasswords
# and paste the 16 characters into SMTP_PASS (spaces optional).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465 (implicit TLS), false for 587 (STARTTLS). Defaults from the port.
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
# The From header. Gmail requires this to be the SMTP_USER address (or an alias
# you have verified on the account); anything else is rewritten or rejected.
MAIL_FROM=Milagro Universe <your_gmail_address@gmail.com>
